{
	"name": "imgsearch",
	"version": "0.1.0",
	"description": "Intelligent image search via LLM-driven interactive questioning",
	"bin": {
		"imgsearch": "./dist/index.js"
	},
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsx src/index.ts",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@llm-image/shared": "workspace:*",
		"@qdrant/js-client-rest": "^1.12.0",
		"commander": "^15.0.0",
		"es-toolkit": "^1.27.0",
		"smol-toml": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
