# LLM (问题生成) — 复用 imgval 约定
LLM_PROVIDER=openai
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_DETAIL=low

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_BASE=

# Embedding (Jina CLIP v2 — 多模态文本+图片)
JINA_API_KEY=
JINA_MODEL=jina-clip-v2
JINA_API_BASE=https://api.jina.ai/v1
JINA_DIMENSIONS=1024

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=images
QDRANT_API_KEY=

# imgsearch
IMGSEARCH_DB_DIR=

# 算法参数
IMGSEARCH_ALPHA=0.5
IMGSEARCH_LAMBDA=8
IMGSEARCH_BEAM_SIZE=500
IMGSEARCH_TOPK_QUESTIONS=50
IMGSEARCH_CANDIDATE_QUESTIONS=5
IMGSEARCH_IG_THRESHOLD=0.05
IMGSEARCH_MAX_ROUNDS=8
IMGSEARCH_MIN_ROUNDS=2
IMGSEARCH_SHOW_THUMBNAILS=false

# 导入
IMGSEARCH_MAX_IMAGE_DIMENSION=512
IMGSEARCH_IMPORT_CONCURRENCY=4
IMGSEARCH_EMBED_TEXT_BATCH=64
IMGSEARCH_EMBED_IMAGE_BATCH=16
