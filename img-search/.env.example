# LLM (问题生成) — 复用 imgval 约定
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_BASE=

# Embedding (Jina CLIP v2 — 多模态文本+图片)
JINA_API_KEY=
JINA_MODEL=jina-clip-v2
JINA_API_BASE=https://api.jina.ai/v1
JINA_DIMENSIONS=1024

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=images
QDRANT_API_KEY=

# img-search（与 img-val、img-tagger 共用的统一数据目录，默认 ~/.img-data）
IMGDATA_DIR=

# 算法与导入参数配置文件实际路径为 <IMGDATA_DIR>/imgsearch.toml（默认 ~/.img-data/imgsearch.toml）
